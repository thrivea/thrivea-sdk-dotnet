<?xml version="1.0" encoding="utf-8"?>
<!-- A public package builds only from nuget.org: no private feed of ours, and the same restore on every machine and in CI. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
